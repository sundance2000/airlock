#!/usr/bin/env bash
# airlock - run Claude Code isolated in a Podman container (macOS).
# Written for the bash 3.2 that ships with macOS.
set -euo pipefail

IMAGE="${AIRLOCK_IMAGE:-localhost/airlock:latest}"       # the image we build and run
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/airlock"      # everything airlock keeps on disk
SHARED="$DATA/claude"                                    # login, settings and sessions, shared by all folders
DIR=$(pwd -P)                                            # the project, mounted at this very path
HASH=$(printf '%s' "$DIR" | shasum -a 256 | cut -c1-12)  # short id of this folder
BOX="$DATA/$HASH/home"                                   # this folder's container home
SHARE="${AIRLOCK_SHARE:-}"                               # Containerfile, zshrc and egress.nft

die() { printf 'airlock: %s\n' "$*" >&2; exit 1; }

# Copy host -> container, for files and directories alike.
copy() { [ -e "$1" ] || return 0; rm -rf "${2:?}/$(basename "$1")"; cp -R "$1" "$2"; }

case "$DIR" in
    "/" | "$(cd -P "$HOME" && pwd -P)") die "not here - cd into a project directory" ;;
esac

if [ -z "$SHARE" ]; then
    for d in "$(dirname "$0")/../share" "$DATA/dist"; do   # d: candidate share directory
        if [ -f "$d/Containerfile" ]; then SHARE=$(cd -P "$d" && pwd); break; fi
    done
fi
[ -n "$SHARE" ] || die "share files not found - set AIRLOCK_SHARE"

build() { podman build "$@" -t "$IMAGE" -f "$SHARE/Containerfile" "$SHARE"; }

# One interactive container per run, gone as soon as the terminal is. The image
# entrypoint puts the egress rules up before it hands over to Claude.
launch() {
    podman image exists "$IMAGE" || build
    mkdir -p "$SHARED" "$BOX"
    # The host wins for settings; login and sessions live in the container.
    copy "$HOME/.claude/settings.json" "$SHARED"
    copy "$HOME/.claude/CLAUDE.md" "$SHARED"
    copy "$HOME/.claude/commands" "$SHARED"
    copy "$HOME/.claude/agents" "$SHARED"
    copy "$HOME/.zshrc" "$BOX"
    exec podman run --rm -it \
        --label "airlock=$DIR" \
        --userns "keep-id:uid=1000,gid=1000" \
        --cap-add NET_ADMIN \
        --dns 9.9.9.9 --dns 1.1.1.1 \
        --sysctl net.ipv6.conf.all.disable_ipv6=1 \
        -e "TERM=${TERM:-xterm-256color}" \
        -v "$DIR:$DIR" -v "$BOX:/home/claude" -v "$SHARED:/home/claude/.claude" \
        -w "$DIR" "$IMAGE" "$@"
}

case "${1:-}" in
    shell)  shift; launch zsh "$@" ;;
    update) build --build-arg "REBUILD=$(date +%s)" ;;
    reset)
        printf 'delete the container home for %s? [y/N] ' "$DIR"
        read -r answer                                   # answer: y deletes, anything else keeps
        case "$answer" in y|Y) rm -rf "${DATA:?}/$HASH" ;; esac ;;
    help)
        cat <<'USAGE'
claude [args]   start Claude Code here; without arguments it resumes the last session
claude shell    a zsh shell in a container of its own
claude update   rebuild the image with the current Claude Code
claude reset    delete this folder's container home
USAGE
        ;;
    "")     launch claude --continue ;;
    *)      launch claude "$@" ;;
esac
