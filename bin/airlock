#!/usr/bin/env bash
# airlock - run Claude Code in a container that sees this folder and the
# internet, and nothing else. macOS + Podman, bash 3.2.
set -euo pipefail

image=localhost/airlock:latest                              # built from share/
project=$(pwd -P)                                           # the folder we are in
key=$(printf '%s' "$project" | shasum -a 256 | cut -c1-12)  # identifies this folder
container="airlock-$(basename "$project")-$key"
home="$HOME/.local/share/airlock/$key"                      # mounted as ~ in the container
config="$HOME/.local/share/airlock/config"                  # mounted as ~/.claude, the same one everywhere

files=$(dirname "$0")/../share                              # Containerfile, entrypoint, egress.nft
[ -f "$files/Containerfile" ] || files="$HOME/.local/share/airlock/image"

die() { printf 'airlock: %s\n' "$*" >&2; exit 1; }

build() { podman build "$@" -t "$image" -f "$files/Containerfile" "$files"; }

# Config is copied from the mac, not mounted: a container that could write your
# real ~/.claude could put a hook there that your mac would then run.
copy() {
    local from=$1
    local to
    to="$2/$(basename "$from")"
    [ -e "$from" ] || return 0
    rm -rf "$to"
    cp -R "$from" "$2"
}

case "$project" in
    "/" | "$HOME") die "cd into a project folder first" ;;
esac

case "${1:-}" in
    update)
        build --build-arg "rebuild=$(date +%s)"
        exit 0 ;;
    reset)
        podman rm -f "$container" >/dev/null 2>&1 || true
        rm -rf "$home"
        printf 'airlock: removed the container and home for %s\n' "$project"
        exit 0 ;;
esac

podman image exists "$image" || build

mkdir -p "$config" "$home"
for setting in settings.json CLAUDE.md commands agents; do
    copy "$HOME/.claude/$setting" "$config"
done
copy "$HOME/.zshrc" "$home"

# One terminal at a time: a second would end up sharing the first one's tty.
if [ -n "$(podman ps -q --filter "name=^$container$")" ]; then
    die "already running in this folder"
fi

if podman container exists "$container"; then
    # Restarting reruns `claude --continue`, so the session carries on and
    # everything apt installed in there is still present.
    [ "$#" -eq 0 ] && exec podman start --attach --interactive "$container"
    # Arguments cannot reach a container that already exists, so replace it.
    podman rm -f "$container" >/dev/null
fi

[ "$#" -gt 0 ] || set -- --continue        # no arguments: resume the last session here
exec podman run -it --name "$container" \
    --userns "keep-id:uid=1000,gid=1000" \
    --cap-add NET_ADMIN \
    --dns 9.9.9.9 --dns 1.1.1.1 \
    --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    -e "TERM=${TERM:-xterm-256color}" \
    -v "$project:$project" -v "$home:/home/claude" -v "$config:/home/claude/.claude" \
    -w "$project" "$image" claude "$@"
