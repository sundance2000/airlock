#!/usr/bin/env bash
# airlock - run Claude Code in a container that sees this folder and the
# internet, and nothing else. macOS + Podman, bash 3.2.
set -euo pipefail

image_name=localhost/airlock:latest                                  # the image we build and run
image_dir="$HOME/.local/share/airlock/image"                         # Containerfile and the two files it copies, put here by install.sh
project_dir=$(pwd -P)                                                # the folder you are in, the only one the container sees
project_id=$(printf '%s' "$project_dir" | shasum -a 256 | cut -c1-12)
container_name="airlock-$(basename "$project_dir")-$project_id"
container_home="$HOME/.local/share/airlock/$project_id"              # mounted as ~ inside the container
container_stamp="$HOME/.local/share/airlock/$project_id.created"     # when that container was made, to spot a newer airlock
build_stamp="$HOME/.local/share/airlock/image-built"                 # touched after every build, to spot a newer image_dir

die() { printf 'airlock: %s\n' "$*" >&2; exit 1; }

build_image() {
    podman build "$@" -t "$image_name" -f "$image_dir/Containerfile" "$image_dir"
    # Containers keep the image they were built from, so the old ones have to
    # go for a new image to take effect. Running ones are left alone.
    for stale in $(podman ps -aq --filter "name=^airlock-" --filter status=created --filter status=exited); do
        podman rm -f "$stale" >/dev/null
    done
    touch "$build_stamp"
}

# Stale once this script has changed, because a container keeps the flags it
# was created with - a new COLORTERM or mount never reaches an old one.
container_is_current() {
    podman container exists "$container_name" || return 1
    [ -f "$container_stamp" ] || return 1
    [ -z "$(find "$0" -newer "$container_stamp")" ]
}

# Stale once install.sh has copied a newer image definition into place.
image_is_current() {
    podman image exists "$image_name" || return 1
    [ -f "$build_stamp" ] || return 1
    [ -z "$(find "$image_dir" -newer "$build_stamp")" ]
}

case "$project_dir" in
    "/" | "$HOME") die "cd into a project folder first" ;;
esac

[ -f "$image_dir/Containerfile" ] || die "$image_dir is missing - run ./install.sh"

case "${1:-}" in
    update)
        build_image --build-arg "rebuild=$(date +%s)"
        exit 0 ;;
    reset)
        podman rm -f "$container_name" >/dev/null 2>&1 || true
        rm -rf "$container_home" "$container_stamp"
        printf 'airlock: removed the container and home for %s\n' "$project_dir"
        exit 0 ;;
esac

image_is_current || build_image

mkdir -p "$container_home" "$HOME/.claude"
# Claude Code keeps ~/.claude.json beside ~/.claude rather than inside it, and
# refuses to start without it. Put it in the mounted directory and link to it,
# so it holds the account for every folder instead of one per folder.
[ -f "$HOME/.claude/claude.json" ] || echo '{}' > "$HOME/.claude/claude.json"
ln -sfn .claude/claude.json "$container_home/.claude.json"

# Your real ~/.claude, so login, settings and sessions are the same inside and
# out. ~/.zshrc is read-only because nothing in there needs to write it.
mounts=(-v "$project_dir:$project_dir" -v "$container_home:/home/claude" -v "$HOME/.claude:/home/claude/.claude")
[ -f "$HOME/.zshrc" ] && mounts+=(-v "$HOME/.zshrc:/home/claude/.zshrc:ro")

# What the terminal can render. Without COLORTERM a 24-bit prompt falls back
# to 256 colours and looks different from the same terminal outside.
colors=(-e "TERM=${TERM:-xterm-256color}")
[ -n "${COLORTERM:-}" ] && colors+=(-e "COLORTERM=$COLORTERM")

# One terminal at a time: a second would end up sharing the first one's tty.
if [ -n "$(podman ps -q --filter "name=^$container_name$")" ]; then
    die "already running in this folder"
fi

if container_is_current && [ "$#" -eq 0 ]; then
    # Restarting runs the entrypoint again, which resumes this folder's
    # session; everything apt installed in the container is still present.
    exec podman start --attach --interactive "$container_name"
fi

# Arguments and changed flags cannot reach a container that already exists.
podman rm -f "$container_name" >/dev/null 2>&1 || true
touch "$container_stamp"
exec podman run -it --name "$container_name" \
    --userns "keep-id:uid=1000,gid=1000" \
    --cap-add NET_ADMIN,SETPCAP \
    --dns 9.9.9.9 --dns 1.1.1.1 \
    --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    "${colors[@]}" "${mounts[@]}" -w "$project_dir" "$image_name" claude "$@"
