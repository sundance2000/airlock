#!/usr/bin/env bash
# airlock - run Claude Code, Codex, or herdr with both in its panes, in a
# container that sees this folder and the internet, and nothing else.
# macOS + Podman, bash 3.2.
set -euo pipefail

# What to run is the name this script is called by: `claude`, `codex` or
# `herdr`, all links made by install.sh. Called as `airlock` it runs Claude Code, and also
# takes the commands that edit .airlock, which `claude` would mistake for a
# prompt: `claude add a login button`.
called_as=$(basename "$0")
case "$called_as" in
    herdr) tool=herdr ;;
    codex) tool=codex ;;
    *)     tool=claude ;;
esac

image_name=localhost/airlock:latest                                  # the image we build and run
image_dir="$HOME/.local/share/airlock/image"                         # Containerfile and the two files it copies, put here by install.sh
project_dir=$(pwd -P)                                                # the folder you are in, the only one the container sees
project_id=$(printf '%s' "$project_dir" | shasum -a 256 | cut -c1-12)
claude_container="airlock-$(basename "$project_dir")-$project_id"     # this folder's Claude Code container
herdr_container="airlock-herdr-$(basename "$project_dir")-$project_id" # and its herdr container, kept apart from it
codex_container="airlock-codex-$(basename "$project_dir")-$project_id" # and its Codex container
herdr_volume="airlock-herdr-$project_id"                              # ~/.config/herdr in that container: sockets and sessions
container_home="$HOME/.local/share/airlock/$project_id"              # mounted as ~ inside both containers
case "$tool" in
    herdr)
        container_name=$herdr_container
        container_stamp="$HOME/.local/share/airlock/$project_id.herdr.created" ;; # when that container was made, to spot a newer airlock
    codex)
        container_name=$codex_container
        container_stamp="$HOME/.local/share/airlock/$project_id.codex.created" ;;
    *)
        container_name=$claude_container
        container_stamp="$HOME/.local/share/airlock/$project_id.created" ;;
esac
build_stamp="$HOME/.local/share/airlock/image-built"                 # touched after every build, to spot a newer image_dir
config="$project_dir/.airlock"                                       # this folder's settings: the ports to publish

die() { printf 'airlock: %s\n' "$*" >&2; exit 1; }

build_image() {
    podman build "$@" -t "$image_name" -f "$image_dir/Containerfile" "$image_dir"
    # Containers keep the image they were built from, so the old ones have to
    # go for a new image to take effect. Running ones are left alone.
    for stale in $(podman ps -aq --filter "name=^airlock-" --filter status=created --filter status=exited); do
        podman rm -f "$stale" >/dev/null
    done
    touch "$build_stamp"
}

# Stale once this script has changed, because a container keeps the flags it
# was created with - a new COLORTERM or mount never reaches an old one. The
# same goes for its ports, which it carries in a label to compare against.
container_is_current() {
    podman container exists "$container_name" || return 1
    [ -f "$container_stamp" ] || return 1
    [ -z "$(find "$0" -newer "$container_stamp")" ] || return 1
    [ "$(podman container inspect -f '{{index .Config.Labels "airlock.ports"}}' "$container_name")" = "$port_list" ]
}

# $1 as mac:container - `3000` becomes 3000:3000 - or a failure if it is not
# a port or a pair of them. Nothing else gets through: no address, so a port
# can never be published beyond the Mac's 127.0.0.1.
port_pair() {
    local mac inside port
    case "$1" in
        "" | *[!0-9:]* | :* | *: | *:*:*) return 1 ;;
        *:*) mac=${1%%:*} inside=${1#*:} ;;
        *)   mac=$1 inside=$1 ;;
    esac
    for port in "$mac" "$inside"; do
        [ "${#port}" -le 5 ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
    done
    printf '%s:%s\n' "$mac" "$inside"
}

# Each port in .airlock as mac:container, one per line. A line it does not
# understand stops airlock rather than being skipped.
config_pairs() {
    [ -f "$config" ] || return 0
    local line key value rest pair
    while IFS= read -r line || [ -n "$line" ]; do
        read -r key value rest <<< "${line%%#*}"
        case "${key:-}" in
            "") continue ;;
            port) ;;
            *) die "$config: unknown setting '$key'" ;;
        esac
        [ -z "${rest:-}" ] || die "$config: one port per line: '$line'"
        pair=$(port_pair "${value:-}") || die "$config: not a port or mac:container pair: '$line'"
        printf '%s\n' "$pair"
    done < "$config"
}

# `airlock add port 3000 8080:80`: append to .airlock what is not in it yet.
add_ports() {
    local existing pair
    existing=$(config_pairs)
    for arg in "$@"; do
        pair=$(port_pair "$arg") || die "not a port or mac:container pair: $arg"
        if printf '%s\n' "$existing" | grep -qx "$pair"; then
            printf 'airlock: port %s is already in %s\n' "$pair" "$config"
            continue
        fi
        # The Mac side can only be published once.
        if printf '%s\n' "$existing" | grep -q "^${pair%%:*}:"; then
            die "Mac port ${pair%%:*} is already published in $config"
        fi
        printf 'port %s\n' "$pair" >> "$config"
        existing="$existing
$pair"
        printf 'airlock: added port %s\n' "$pair"
    done
}

# `airlock remove port 3000`: drop matching lines, keep everything else.
remove_ports() {
    local line key value rest pair kept found
    [ -f "$config" ] || die "$config does not exist"
    config_pairs >/dev/null
    for arg in "$@"; do
        pair=$(port_pair "$arg") || die "not a port or mac:container pair: $arg"
        kept="" found=""
        while IFS= read -r line || [ -n "$line" ]; do
            read -r key value rest <<< "${line%%#*}"
            if [ "${key:-}" = port ] && [ "$(port_pair "$value")" = "$pair" ]; then
                found=1
                continue
            fi
            kept="$kept$line
"
        done < "$config"
        [ -n "$found" ] || die "port $pair is not in $config"
        printf '%s' "$kept" > "$config"
        printf 'airlock: removed port %s\n' "$pair"
    done
}

# Stale once install.sh has copied a newer image definition into place.
image_is_current() {
    podman image exists "$image_name" || return 1
    [ -f "$build_stamp" ] || return 1
    [ -z "$(find "$image_dir" -newer "$build_stamp")" ]
}

case "$project_dir" in
    "/" | "$HOME") die "cd into a project folder first" ;;
esac

if [ "$called_as" = airlock ]; then
    case "${1:-} ${2:-}" in
        "add port" | "remove port")
            [ "$#" -ge 3 ] || die "usage: airlock $1 port <port|mac:container>..."
            action=$1
            shift 2
            if [ "$action" = add ]; then add_ports "$@"; else remove_ports "$@"; fi
            printf 'airlock: takes effect the next time claude, codex or herdr starts here\n'
            exit 0 ;;
    esac
fi

[ -f "$image_dir/Containerfile" ] || die "$image_dir is missing - run ./install.sh"

case "${1:-}" in
    update)
        build_image --build-arg "rebuild=$(date +%s)"
        exit 0 ;;
    reset)
        # All containers, because they share the home that goes with them.
        podman rm -f "$claude_container" "$codex_container" "$herdr_container" >/dev/null 2>&1 || true
        podman volume rm -f "$herdr_volume" >/dev/null 2>&1 || true
        rm -rf "$container_home" "$HOME/.local/share/airlock/$project_id".*created
        printf 'airlock: removed the containers and home for %s\n' "$project_dir"
        exit 0 ;;
esac

image_is_current || build_image

mkdir -p "$container_home" "$HOME/.claude" "$HOME/.codex"
# Claude Code keeps ~/.claude.json beside ~/.claude rather than inside it, and
# refuses to start without it. Put it in the mounted directory and link to it,
# so it holds the account for every folder instead of one per folder.
[ -f "$HOME/.claude/claude.json" ] || echo '{}' > "$HOME/.claude/claude.json"
ln -sfn .claude/claude.json "$container_home/.claude.json"

# Your real ~/.claude and ~/.codex, so login, settings and sessions are the
# same inside and out. Both go into every container, so `codex` in a herdr pane
# or in the Claude Code container's shell finds its login too. ~/.zshrc is
# read-only because nothing in there needs to write it.
mounts=(-v "$project_dir:$project_dir" -v "$container_home:/home/claude"
    -v "$HOME/.claude:/home/claude/.claude" -v "$HOME/.codex:/home/claude/.codex")
[ -f "$HOME/.zshrc" ] && mounts+=(-v "$HOME/.zshrc:/home/claude/.zshrc:ro")
# herdr talks to its server through unix sockets in ~/.config/herdr, and
# those cannot be connected to on a directory shared from the Mac. So that
# directory is a Podman volume, which lives in the VM and outlives the
# container. :U hands it to uid 1000.
if [ "$tool" = herdr ]; then
    mounts+=(-v "$herdr_volume:/home/claude/.config/herdr:U")
    # Only the config file from the Mac: the rest of its ~/.config/herdr is
    # the Mac's own server - socket, logs, sessions.
    if [ -f "$HOME/.config/herdr/config.toml" ]; then
        mounts+=(-v "$HOME/.config/herdr/config.toml:/home/claude/.config/herdr/config.toml:ro")
    fi
fi

# Ports to publish, from .airlock in this folder: `port 3000` or
# `port 8080:80` (Mac:container), one per line, # starts a comment. Only ever
# on the Mac's 127.0.0.1, never the LAN, because whatever runs in the
# container can write that file when it does not exist yet. When it does, it
# is mounted read-only over itself, so the container cannot change it.
ports=()
port_list=""
pairs=$(config_pairs)
for pair in $pairs; do
    ports+=(-p "127.0.0.1:$pair")
    port_list="$port_list $pair"
done
if [ -f "$config" ]; then
    mounts+=(-v "$config:$config:ro")
fi

# What the terminal can render. Without COLORTERM a 24-bit prompt falls back
# to 256 colours and looks different from the same terminal outside.
colors=(-e "TERM=${TERM:-xterm-256color}")
[ -n "${COLORTERM:-}" ] && colors+=(-e "COLORTERM=$COLORTERM")

# One terminal at a time: a second would end up sharing the first one's tty.
if [ -n "$(podman ps -q --filter "name=^$container_name$")" ]; then
    die "already running in this folder"
fi

if container_is_current && [ "$#" -eq 0 ]; then
    # Restarting runs the entrypoint again, which resumes this folder's
    # session; everything apt installed in the container is still present.
    exec podman start --attach --interactive "$container_name"
fi

# Arguments and changed flags cannot reach a container that already exists.
podman rm -f "$container_name" >/dev/null 2>&1 || true
touch "$container_stamp"
exec podman run -it --name "$container_name" \
    --userns "keep-id:uid=1000,gid=1000" \
    --cap-add NET_ADMIN,SETPCAP \
    --dns 9.9.9.9 --dns 1.1.1.1 \
    --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    --label "airlock.ports=$port_list" ${ports[@]+"${ports[@]}"} \
    "${colors[@]}" "${mounts[@]}" -w "$project_dir" "$image_name" "$tool" "$@"
