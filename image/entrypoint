#!/bin/sh
# Put the egress rules up while we still have NET_ADMIN, then drop that
# capability for good - not even sudo can get it back - and become the user.
# If the rules fail to apply, the container exits before Claude ever starts.
#
# --keep-groups, not --init-groups: setgroups() is denied inside a rootless
# user namespace, and every other group option calls it.
set -e
nft -f /etc/airlock/egress.nft
exec setpriv --reuid=1000 --regid=1000 --keep-groups \
    --bounding-set=-net_admin,-net_raw -- "$@"
